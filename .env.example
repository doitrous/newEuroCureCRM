# ─────────────────────────────────────────────────────────────
# Aspects Clinica CRM — environment configuration
# Copy to .env.local and fill in. The three CRM Supabase values below are
# mandatory for application startup; integrations are optional unless used.
#
# This file is committed. Never put a real value in it.
# ─────────────────────────────────────────────────────────────

# ── Supabase (data layer) ────────────────────────────────────
# In the old combined `eurocure` app these same CRM-project credentials were
# named CRM_SUPABASE_URL / CRM_SUPABASE_ANON_KEY /
# CRM_SUPABASE_SERVICE_ROLE_KEY. Map their values in Coolify; do not place
# service-role credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Facebook / Instagram (Messenger DMs + FB/IG comments) ────
# FACEBOOK_APP_SECRET verifies the x-hub-signature-256 header on
# POST /api/webhooks/meta; FACEBOOK_WEBHOOK_VERIFY_TOKEN answers the GET
# handshake. Without both, the webhook route returns 503 rather than
# accepting unauthenticated writes.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Backward-compatible old CRM aliases. Prefer the FACEBOOK_* names above for a
# new deployment; do not configure both with different values.
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ── WhatsApp Business Cloud API ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional dedicated secret for POST /api/crm/ingest/whatsapp. When empty,
# CRM_INGEST_API_KEY below is used.
WHATSAPP_INGEST_API_KEY=

# ── Booking / admin site (live reservations + calendar) ──────
# The CRM reads the booking project's Supabase directly (federated read,
# server-only) to power Patient Reservations + Calendar.
# Map these to the old website project's NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY respectively. Both are server-only in this app.
BOOKING_SUPABASE_URL=
BOOKING_SUPABASE_SERVICE_ROLE_KEY=
# Reserved legacy adapter names. The current CRM does not read them because it
# talks to booking Supabase directly; retain only if an external deployment
# wrapper still consumes them.
BOOKING_API_BASE_URL=
BOOKING_API_KEY=

# ── Booking → CRM ingest (reservations become unread leads) ──
# Shared secret. The booking site / n8n POSTs new reservations to
# POST /api/ingest/reservation with header  x-api-key: <this value>
# (or Authorization: Bearer <this value>). Must match on both sides.
# Also authenticates POST /api/crm/ingest/{message,comment,conversation,bulk}.
CRM_INGEST_API_KEY=
# Optional: lead_sources.id to stamp on booking-originated leads.
# This is an acquisition-channel UUID, not the EuroCure/Dr. Ahmad source key.
CRM_BOOKING_SOURCE_ID=

# ── Google Sheets mirror ─────────────────────────────────────
CRM_GOOGLE_SHEETS_TAB_NAME=Leads Collection
CRM_GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── AI (reply assistant + AI auto-audit) ─────────────────────
# Preferred production reply-assistant integration migrated from the old CRM.
# The workflow returns suggestions for moderator review; it never sends them.
N8N_AI_REPLY_WEBHOOK_URL=
N8N_AI_REPLY_WEBHOOK_SECRET=
# Reserved provider variables retained by the new CRM's settings model.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-opus-4-8
NVIDIA_NIM_API_KEY=

# ── Transactional email + cron ───────────────────────────────
# Resend API key. When unset, email rules are logged as "skipped" (never sent),
# so the CRM runs fine without email configured.
RESEND_API_KEY=
# From address for outgoing CRM emails. The domain must be verified in Resend.
EMAIL_FROM="Aspects Clinica Reservations <reservations@aspectsclinica.net>"
# Shared secret guarding /api/cron/overdue-emails. Prefer Authorization:
# Bearer <secret>; the query-token form remains only for legacy schedulers.
CRON_SECRET=
# Timezone for the daily overdue-email schedule + date bucketing.
CRM_TIMEZONE=Africa/Cairo

# ── Data source toggle ───────────────────────────────────────
# "supabase" uses the live DB. "mock" is allowed only in development/test and
# is refused in production so the deployed CRM cannot silently become a demo.
CRM_DATA_SOURCE=supabase

# ── Auth ─────────────────────────────────────────────────────
# Sign-in is real Supabase Auth (email + password) against the CRM project's
# `auth.users`, joined to a `crm_users` profile row via `crm_users.auth_user_id`.
# A user with no active `crm_users` row cannot enter the CRM, even with a valid
# Supabase session. Accounts are provisioned in Supabase, not by the app.
#
# Dev-only: lets an *admin* preview the CRM as another account (sidebar switcher).
# Ignored entirely when NODE_ENV=production. Never set this in a deployed env.
CRM_DEV_IMPERSONATION=0
